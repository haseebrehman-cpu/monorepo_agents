NODE_ENV=development
# HTTP port for this API. The dashboard proxies to 5000. The database port belongs in DATABASE_URL.
PORT=5000
# Shared chatbot Postgres. Connections are pinned to schema cts.
# Use sslmode=no-verify for the Railway proxy certificate.
DATABASE_URL=
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000
# Use a cryptographically random value of at least 32 characters in production.
JWT_SECRET=a6s7adhasd567asd876fasd665fdsa67
CORS_ORIGIN=http://localhost:5173
# Use "none" only when dashboard and API are on different sites (HTTPS required).
COOKIE_SAME_SITE=lax
SUPER_ADMIN_EMAIL=superadmin@igate.com
SUPER_ADMIN_PASSWORD=change-me
SUPER_ADMIN_NAME=Super Admin