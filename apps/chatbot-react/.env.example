VITE_STORE_NAME=RDX Sports
VITE_STOREFRONT_HOST=rdxsports.co.uk
# Used by Node tests and the Vercel /rdx-api proxy. The browser always calls
# /rdx-api (Vite proxy locally, Vercel edge proxy in production) because
# staging CORS rejects localhost and *.vercel.app.
VITE_CHAT_API_URL=https://backend-staging-1a2f.up.railway.app
VITE_TENANT=rdx
VITE_MARKETPLACE=uk
# Optional. When set, tenant/marketplace are omitted from the chat body.
# VITE_SESSION_TOKEN=
