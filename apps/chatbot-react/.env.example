VITE_STORE_NAME=store name here
VITE_STOREFRONT_HOST=storefront host here
# Local `vite dev` / `vite preview` ignore this and use the /rdx-api proxy
# (staging CORS does not allow localhost). Set this on Vercel so production
# calls the backend instead of the Vercel origin.
VITE_CHAT_API_URL=backend url here
VITE_TENANT=tenant here
# Optional. When set, tenant/marketplace are omitted from the chat body.
# VITE_SESSION_TOKEN=session token here
