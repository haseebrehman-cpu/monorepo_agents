# Support chat API origin. The browser calls this directly, so the origin must
# be listed in the API's CORS allowlist. Restart the Next dev server after changing it.
NEXT_PUBLIC_CHAT_API_BASE=http://vlrhtlptxpq8r2eklos4klva.159.65.48.87.sslip.io

NEXT_PUBLIC_STORE_NAME=RDX Sports

# Live chat customer API on cts-backend. Without it a handoff only shows the reference,
# and the chat never switches to a person. This origin must be in cts-backend CORS_ORIGIN.
# Next inlines NEXT_PUBLIC_* at build time. On Coolify, mark it Available at Buildtime
# and redeploy. A container restart does not change the browser bundle.
# LIVE_CHAT_API_BASE is the same URL, read when the container starts, if the build arg was empty.
NEXT_PUBLIC_LIVE_CHAT_API_BASE=http://localhost:5000/api/live-chat/customer
