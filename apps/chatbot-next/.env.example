# Support chat API origin. The browser calls it through the /rdx-api rewrite
# in next.config.ts, because the API only allows same-origin requests by default.
CHAT_API_URL=http://vlrhtlptxpq8r2eklos4klva.159.65.48.87.sslip.io

# Optional. Base path the browser uses for API calls. Defaults to /rdx-api.
# Set it to the API origin only if that origin is listed in API_CORS_ORIGINS.
# NEXT_PUBLIC_CHAT_API_BASE=/rdx-api

NEXT_PUBLIC_STORE_NAME=RDX Sports

# Live chat customer API on cts-backend. Without it a handoff only shows the reference,
# and the chat never switches to a person. This origin must be in cts-backend CORS_ORIGIN.
NEXT_PUBLIC_LIVE_CHAT_API_BASE=http://localhost:5000/api/live-chat/customer
