# Live chat customer API on cts-backend. Without it a handoff only shows the reference,
# and the chat never switches to a person. This origin must be in cts-backend CORS_ORIGIN.
NEXT_PUBLIC_LIVE_CHAT_API_BASE=http://localhost:5000/api/live-chat/customer
