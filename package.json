{
  "name": "monorepo_agent_app",
  "version": "1.0.0",
  "private": true,
  "description": "RDX agent apps monorepo",
  "packageManager": "npm@11.14.1",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@rdx/api",
    "dev:dashboard": "npm run dev --workspace=@rdx/dashboard",
    "dev:chatbot": "npm run dev --workspace=@rdx/chatbot",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "turbo": "^2.5.5"
  }
}
