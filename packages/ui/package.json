{
  "name": "@rdx/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared UI kit for the RDX apps",
  "type": "module",
  "main": "./index.ts",
  "types": "./index.ts",
  "imports": {
    "#components/*": "./components/*.tsx",
    "#lib/*": "./lib/*.ts",
    "#hooks/*": "./hooks/*.ts"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "default": "./index.ts"
    },
    "./styles.css": "./styles.css",
    "./components/*": "./components/*.tsx",
    "./lib/*": "./lib/*.ts",
    "./hooks/*": "./hooks/*.ts"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.6",
    "lucide-react": "^1.43.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@rdx/tsconfig": "*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^26.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
